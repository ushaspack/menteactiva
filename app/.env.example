# Copia a .env.local y rellena. Nunca subas .env.local.
# Obligatorio en producción: cadena aleatoria de 32+ caracteres (openssl rand -hex 32)
SESSION_SECRET=
# 0 desactiva el acceso de demostración (ponlo a 0 en producción)
DEMO_MODE=1

# --- Fase siguiente: los crea el usuario en su propia cuenta ---
# Supabase / Postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Correo transaccional (Resend)
RESEND_API_KEY=
EMAIL_FROM=
# Google (OAuth con tu propia app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
